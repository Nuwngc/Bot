# ===== Bat buoc =====
# Khoa ma hoa cookie/API key truoc khi luu DB.
# Sinh bang: npm run secret
# CANH BAO: doi gia tri nay = khong giai ma duoc cookie cu, moi nguoi phai nhap lai.
APP_SECRET=

# Tai khoan quan tri dau tien (chi dung lan dau, hoac de dat lai mat khau admin)
ADMIN_USER=admin
ADMIN_PASS=

# ===== Tuy chon =====
PORT=3000
DB_PATH=./data/app.db
NODE_ENV=development

# So bot chay cung luc toi da tren ca server (moi bot ton ~100-150MB RAM)
MAX_BOTS=3
MAX_ZALO=3

# So bot moi loai (FB / Zalo) mot tai khoan duoc tao. Admin khong gioi han.
MAX_PER_USER=3

# Thoi gian trong game (giay)
NOITU_TIMEOUT=60
MASOI_NIGHT=70
MASOI_DAY=90
MASOI_VOTE=60
MASOI_MIN=4

# ===== Bot Zalo (Python) =====
# Mac dinh dung thu muc zalo/ trong project va zalo/.venv/bin/python neu co.
# Chi can dat khi de bot Zalo o cho khac.
# ZALO_DIR=/duong/dan/toi/BotZalo
# ZALO_PYTHON=/duong/dan/toi/python
